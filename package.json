{
  "name": "bms-pos-electron",
  "version": "1.0.3",
  "description": "BMS Point of Sale System built with Electron.js",
  "main": "src/electron/main.js",
  "scripts": {
    "dev-vite": "vite",
    "build-react": "vite build",
    "start": "electron . --no-sandbox",
    "dev": "concurrently \"npm run dev-vite\" \"wait-on http://localhost:3001 && electron . --dev --no-sandbox\"",
    "dev-touch": "concurrently \"npm run dev-vite\" \"wait-on http://localhost:3001 && electron . --dev --no-sandbox --display=2\"",
    "kiosk": "npm run build-react && electron . --no-sandbox",
    "display0": "npm run build-react && electron . --no-sandbox --display=0",
    "display1": "npm run build-react && electron . --no-sandbox --display=1",
    "display2": "npm run build-react && electron . --no-sandbox --display=2",
    "build": "npm run build-react && electron-builder",
    "pack": "npm run build-react && electron-builder --dir",
    "build:linux": "npm run build:api:linux-arm64 && npm run build-react && electron-builder --linux",
    "build:win": "npm run build:api:win-x64 && npm run build-react && electron-builder --win",
    "build:mac": "npm run build:api:osx-arm64 && npm run build-react && electron-builder --mac",
    "build:all": "npm run build-react && electron-builder --linux --win --mac",
    "build:api:linux-arm64": "dotnet publish BMS_POS_API/BMS_POS_API.csproj -c Release -r linux-arm64 --self-contained true -p:PublishSingleFile=true -p:DebugType=none -o resources/api",
    "build:api:linux-x64": "dotnet publish BMS_POS_API/BMS_POS_API.csproj -c Release -r linux-x64 --self-contained true -p:PublishSingleFile=true -p:DebugType=none -o resources/api",
    "build:api:win-x64": "dotnet publish BMS_POS_API/BMS_POS_API.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:DebugType=none -o resources/api",
    "build:api:osx-arm64": "dotnet publish BMS_POS_API/BMS_POS_API.csproj -c Release -r osx-arm64 --self-contained true -p:PublishSingleFile=true -p:DebugType=none -o resources/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "E2E_HEADED=true playwright test",
    "test:e2e:seed": "bash scripts/seed-e2e.sh",
    "typecheck": "tsc --noEmit",
    "generate-types": "bash scripts/generate-types.sh"
  },
  "keywords": [
    "pos",
    "point-of-sale",
    "electron",
    "sqlite"
  ],
  "author": "Marc",
  "license": "ISC",
  "build": {
    "appId": "com.bms.pos",
    "productName": "BMS Point of Sale",
    "copyright": "Copyright © 2026 Marc",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "src/electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/api",
        "to": "api",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "BMS_Point_of_Sale-${version}-${arch}.AppImage",
      "category": "Office",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.business"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BMS Point of Sale"
    },
    "publish": {
      "provider": "github",
      "owner": "decentaro",
      "repo": "BMS-Point-of-Sale-System"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "vitest": "^4.1.4",
    "wait-on": "^8.0.4"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "jsbarcode": "^3.12.1",
    "lucide-react": "^0.540.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.20.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^3.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
